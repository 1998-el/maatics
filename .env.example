# Firebase Admin (obtenir depuis Console Firebase → Paramètres du projet → Comptes de service)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMTP (obtenir depuis LWS → Service Email → Configuration SMTP)
SMTP_HOST=mail.maatics.com
SMTP_PORT=465
SMTP_USER=contact@maatics.com
SMTP_PASSWORD=your-smtp-password-here
CONTACT_NOTIFICATION_TO=contact@maatics.com